# ============================================================================
# Docker infrastructure ONLY — for a production/VPS host running just the
# Docker Compose stack (no Node app on that machine). For local development
# where the app also runs on the same machine, use .env.example instead, which
# includes these same variables plus the app-facing connection strings.
#
# Copy this file to .env in the same directory as docker-compose.yml and fill
# in real values. NEVER commit the resulting .env file.
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=dtmsn_app
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=dtmsn
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_use_a_strong_password
PGADMIN_PORT=5050

# --- Redis ---
REDIS_PASSWORD=changeme_use_a_strong_password
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=dtmsn_minio_admin
MINIO_ROOT_PASSWORD=changeme_use_a_strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_BACKUPS=backups
