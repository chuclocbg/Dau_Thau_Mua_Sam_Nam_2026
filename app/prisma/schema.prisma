  status     AcceptanceMinuteStatus @default(DRAFT)
  signedBy   String?
  signedAt   String?
  notes      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  request AcceptanceRequest @relation(fields: [requestId], references: [id])
  session AcceptanceSession @relation(fields: [sessionId], references: [id])

  @@index([requestId])
  @@map("acceptance_minutes")
}

model AcceptanceHistoryEntry {
  id          String            @id @default(uuid())
  requestId   String
  action      AcceptanceAction
  performedBy String
  performedAt String
  fromStatus  AcceptanceStatus?
  toStatus    AcceptanceStatus?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  request AcceptanceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId, performedAt])
  @@map("acceptance_history")
}

model AcceptanceAttachment {
  id           String            @id @default(uuid())
  requestId    String
  fileName     String
  fileType     String
  fileSize     BigInt
  uploadedBy   String
  documentType AcceptanceDocType
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  request AcceptanceRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("acceptance_attachments")
}

// ─── Phase J — Auth Module (Phase M1 production schema) ──────────────────────
// IMPLEMENTED, PENDING PRODUCTION VERIFICATION. Mirrors src/auth/types/authTypes.ts
// and src/auth/types/auditTypes.ts. `Auth` prefix avoids collision with reserved
// words (user, session) — same defensive convention as the `Md` prefix on MasterData.

enum AuthPermissionScope {
  OWN
  DEPARTMENT
  ALL
}

enum AuthPolicyEffect {
  ALLOW
  DENY
}

model AuthUser {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String    @unique
  displayName       String
  departmentId      String
  roleIds           String[]  @default([])
  passwordHash      String?
  externalId        String?
  externalProvider  String?
  isActive          Boolean   @default(true)
  isLocked          Boolean   @default(false)
  failedLoginCount  Int       @default(0)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions            AuthSession[]
  delegationsFrom     AuthDelegationGrant[]   @relation("DelegationFrom")
  delegationsTo       AuthDelegationGrant[]   @relation("DelegationTo")
  permissionGrants    AuthPermissionGrant[]
  approvalHierarchies AuthApprovalHierarchy[]

  @@index([departmentId])
  @@map("auth_users")
}

model AuthRole {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  permissionIds String[] @default([])
  parentRoleId  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("auth_roles")
}

model AuthPermission {
  id          String              @id @default(uuid())
  resource    String
  action      String
  scope       AuthPermissionScope
  conditions  Json?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([resource, action])
  @@map("auth_permissions")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             AuthUser  @relation(fields: [userId], references: [id])
  refreshTokenHash String
  issuedAt         DateTime
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  revokedBy        String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@map("auth_sessions")
}

model AuthDelegationGrant {
  id            String              @id @default(uuid())
  fromUserId    String
  fromUser      AuthUser            @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        AuthUser            @relation("DelegationTo", fields: [toUserId], references: [id])
  permissionIds String[]            @default([])
  scope         AuthPermissionScope
  validFrom     DateTime
  validUntil    DateTime
  reason        String
  legalBasis    Json
  revokedAt     DateTime?
  revokedBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@map("auth_delegation_grants")
}

model AuthPermissionGrant {
  id           String    @id @default(uuid())
  userId       String
  user         AuthUser  @relation(fields: [userId], references: [id])
  permissionId String
  grantedBy    String
  validFrom    DateTime
  validUntil   DateTime?
  legalBasis   Json?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@map("auth_permission_grants")
}

model AuthApprovalHierarchy {
  id             String    @id @default(uuid())
  userId         String
  user           AuthUser  @relation(fields: [userId], references: [id])
  departmentId   String
  authorityLevel Int
