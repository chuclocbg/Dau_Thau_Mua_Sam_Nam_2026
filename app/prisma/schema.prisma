// prisma/schema.prisma — Phase M1 Production Prisma Layer
// Status: IMPLEMENTED, PENDING PRODUCTION VERIFICATION (see docs/prisma-production.md)
// Connection config lives in prisma.config.ts (Prisma 7 driver-adapter pattern) — this file
// intentionally has no `url` on the datasource block; see docs/prisma-production.md.
// Run: npx prisma migrate dev --name <description>   (requires DATABASE_URL + a live Postgres)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DocType {
  LAW
  DECREE
  CIRCULAR
  DECISION
  RESOLUTION
  GUIDELINE
  INTERNAL_REGULATION
  UNKNOWN
}

enum DocStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  DRAFT
  REPEALED
}

enum AmendmentType {
  REPLACE
  MODIFY
  ADD
  REPEAL
  SUSPEND
  EXTEND
  IMPLEMENT
}

// ─── Core entities ────────────────────────────────────────────────────────────

model LegalDocument {
  id            String    @id // kebab-case slug
  symbol        String    @unique // "22/2023/QH15"
  title         String
  type          DocType
  issuer        String
  effectiveDate String // YYYY-MM-DD
  expiredDate   String?
  status        DocStatus @default(ACTIVE)
  supersededBy  String?
  replaces      String[]
  source        String
  priority      Int       @default(1)
  tags          String[]
  summary       String
  confidence    Float     @default(1.0)
  fullText      String?   @db.Text

  versions         LegalVersion[]
  articles         Article[]
  appendices       Appendix[]
  keywords         LegalKeyword[]
  citationsFrom    LegalCitation[]       @relation("CitingDoc")
  citationsTo      LegalCitation[]       @relation("CitedDoc")
  amendmentsBase   Amendment[]           @relation("BaseDoc")
  amendmentsAmend  Amendment[]           @relation("AmendingDoc")
  effectivePeriods EffectivePeriod[]
  domains          LegalDocumentDomain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([effectiveDate])
  @@map("legal_documents")
}

model LegalVersion {
  id          String        @id
  documentId  String
  document    LegalDocument @relation(fields: [documentId], references: [id])
  versionDate String // YYYY-MM-DD
  changeNote  String
  amendedById String? // Amendment.id that created this version
  isBaseline  Boolean       @default(false)

  articles   Article[]
  appendices Appendix[]

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("legal_versions")
}

model Article {
  id         String        @id
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id])
  versionId  String?
  version    LegalVersion? @relation(fields: [versionId], references: [id])
  number     Int
  title      String
  content    String        @db.Text
  chapterRef String? // "I", "II", "1"
  sortOrder  Int

  clauses Clause[]

  @@index([documentId, number])
  @@map("legal_articles")
}

model Clause {
  id        String  @id
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  number    Int
  content   String  @db.Text
  sortOrder Int

  points Point[]

  @@index([articleId])
  @@map("legal_clauses")
}

model Point {
  id        String @id
  clauseId  String
  clause    Clause @relation(fields: [clauseId], references: [id])
  label     String // 'a', 'b', 'c'
  content   String @db.Text
  sortOrder Int

  @@index([clauseId])
  @@map("legal_points")
}

model Appendix {
  id         String        @id
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id])
  versionId  String?
  version    LegalVersion? @relation(fields: [versionId], references: [id])
  number     String
  title      String
  content    String        @db.Text

  @@index([documentId])
  @@map("legal_appendices")
}

model LegalCitation {
  id            String        @id
  citingDocId   String
  citingDoc     LegalDocument @relation("CitingDoc", fields: [citingDocId], references: [id])
  citedDocId    String
  citedDoc      LegalDocument @relation("CitedDoc", fields: [citedDocId], references: [id])
  citingArticle String?
  citedArticle  String?
  citedClause   String?
  citedPoint    String?
  formatted     String
  isDirect      Boolean       @default(true)

  @@index([citingDocId])
  @@index([citedDocId])
  @@map("legal_citations")
}

model LegalKeyword {
  id            String         @id
  term          String
  definition    String         @db.Text
  domain        String
  sourceDocId   String?
  sourceDoc     LegalDocument? @relation(fields: [sourceDocId], references: [id])
  sourceArticle String?
  synonyms      String[]

  @@unique([term, domain])
  @@index([domain])
  @@map("legal_keywords")
}

model LegalDomain {
  id          String @id // "dau_thau"
  name        String // "Đấu thầu"
  description String

  documents LegalDocumentDomain[]

  @@map("legal_domains")
}

model LegalDocumentDomain {
  documentId String
  domainId   String
  document   LegalDocument @relation(fields: [documentId], references: [id])
  domain     LegalDomain   @relation(fields: [domainId], references: [id])

  @@id([documentId, domainId])
  @@map("legal_document_domains")
}

model Amendment {
  id                 String        @id
  baseDocumentId     String
  baseDocument       LegalDocument @relation("BaseDoc", fields: [baseDocumentId], references: [id])
  amendingDocumentId String
  amendingDocument   LegalDocument @relation("AmendingDoc", fields: [amendingDocumentId], references: [id])
  amendmentType      AmendmentType
  effectiveDate      String // YYYY-MM-DD
  affectedArticles   String[]
  summary            String

  @@index([baseDocumentId])
  @@map("legal_amendments")
}

model EffectivePeriod {
  id         String        @id
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id])
  versionId  String?
  startDate  String // YYYY-MM-DD
  endDate    String? // null = still in force
  endReason  String?

  @@index([documentId])
  @@map("legal_effective_periods")
}

// ─── Master Data Models (Phase C) ────────────────────────────────────────────
// Status: IMPLEMENTED, PENDING PRODUCTION VERIFICATION (Phase M1) — see docs/prisma-production.md

enum FundSourceType {
  STATE
  ODA
  PPP
  ENTERPRISE
}

model MdDepartment {
  id         String         @id @default(uuid())
  code       String         @unique
  name       String
  level      Int
  parentId   String?
  parent     MdDepartment?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children   MdDepartment[] @relation("DeptHierarchy")
  isActive   Boolean        @default(true)
  isArchived Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("md_departments")
}

model MdEmployee {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  departmentId String
  email        String
  roles        String[]
  isActive     Boolean  @default(true)
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([departmentId])
  @@map("md_employees")
}

model MdApprovalAuthority {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  level      Int      @unique
  maxValue   Decimal  @db.Decimal(18, 2)
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("md_approval_authorities")
}

model MdVendor {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  taxCode       String
  address       String
  contactEmail  String?
  isBlacklisted Boolean  @default(false)
  isActive      Boolean  @default(true)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("md_vendors")
}

model MdFundSource {
  id         String         @id @default(uuid())
  code       String         @unique
  name       String
  type       FundSourceType
  isActive   Boolean        @default(true)
  isArchived Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("md_fund_sources")
}

model MdBudgetYear {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  year        Int
  startDate   String
  endDate     String
  totalBudget Decimal  @db.Decimal(18, 2)
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("md_budget_years")
}

model MdPackageType {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  category   String
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("md_package_types")
}

model MdProcurementMethod {
  id                         String   @id @default(uuid())
  code                       String   @unique
  name                       String
  applicablePackageTypeCodes String[]
  isActive                   Boolean  @default(true)
  isArchived                 Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("md_procurement_methods")
}

model MdProcurementCategory {
  id               String                  @id @default(uuid())
  code             String                  @unique
  name             String
  packageTypeCode  String
  parentCategoryId String?
  parent           MdProcurementCategory?  @relation("CatHierarchy", fields: [parentCategoryId], references: [id])
  children         MdProcurementCategory[] @relation("CatHierarchy")
  isActive         Boolean                 @default(true)
  isArchived       Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("md_procurement_categories")
}

model MdDocumentTemplate {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  templateType     String
  content          String
  applicableStates String[]
  isActive         Boolean  @default(true)
  isArchived       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("md_document_templates")
}

// ─── Phase D: Procurement Package ────────────────────────────────────────────
// Status: IMPLEMENTED, PENDING PRODUCTION VERIFICATION (Phase M1) — see docs/prisma-production.md

enum PackageStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum ParticipantRole {
  OWNER
  EVALUATOR
  APPROVER
  OBSERVER
}

model ProcurementPackage {
  id                  String        @id @default(uuid())
  packageCode         String        @unique
  packageName         String
  description         String        @default("")
  packageType         String
  procurementMethod   String
  procurementCategory String?
  estimatedValue      Decimal       @db.Decimal(18, 2)
  approvedValue       Decimal?      @db.Decimal(18, 2)
  fundSource          String
  budgetYear          String
  department          String
  owner               String
  workflowId          String?
  status              PackageStatus @default(DRAFT)
  // embedded as JSON
  schedule            Json          @default("{}")
  funding             Json          @default("[]")
  participants        Json          @default("[]")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items       PackageItem[]
  budgets     PackageBudget[]
  attachments PackageAttachment[]
  history     PackageHistory[]

  @@index([status])
  @@index([department])
  @@index([workflowId])
  @@index([createdAt])
  @@map("procurement_packages")
}

model PackageItem {
  id                     String   @id @default(uuid())
  packageId              String
  itemCode               String
  name                   String
  unit                   String
  quantity               Decimal  @db.Decimal(12, 3)
  estimatedUnitPrice     Decimal  @db.Decimal(18, 2)
  estimatedTotal         Decimal  @db.Decimal(18, 2)
  category               String
  technicalSpecification String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  package ProcurementPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_items")
}

model PackageBudget {
  id              String   @id @default(uuid())
  packageId       String
  budgetSource    String
  approvedAmount  Decimal  @db.Decimal(18, 2)
  committedAmount Decimal  @default(0) @db.Decimal(18, 2)
  spentAmount     Decimal  @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  package ProcurementPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_budgets")
}

model PackageAttachment {
  id           String   @id @default(uuid())
  packageId    String
  fileName     String
  fileType     String
  fileSize     Int
  uploadedBy   String
  uploadedAt   DateTime
  documentType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  package ProcurementPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_attachments")
}

model PackageHistory {
  id          String         @id @default(uuid())
  packageId   String
  action      String
  fromStatus  PackageStatus?
  toStatus    PackageStatus?
  performedBy String
  performedAt DateTime
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  package ProcurementPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_history")
}

// ─── Phase E — Procurement Planning ──────────────────────────────────────────
// Status: IMPLEMENTED, PENDING PRODUCTION VERIFICATION (Phase M1) — see docs/prisma-production.md

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  CLOSED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  APPROVED
  REJECTED
  CONVERTED
}

enum AnnualPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  CLOSED
}

enum DemandStatus {
  OPEN
  CONSOLIDATED
  SUBMITTED
}

model ProcurementRequest {
  id               String          @id @default(uuid())
  requestCode      String          @unique
  department       String
  requester        String
  reason           String
  needDescription  String
  needs            Json            @default("[]")
  estimatedCost    Decimal         @db.Decimal(18, 2)
  fundingSource    String
  isUrgent         Boolean         @default(false)
  expectedTimeline String
  priority         RequestPriority @default(MEDIUM)
  legalBasis       String?
  status           RequestStatus   @default(PENDING)
  planId           String?
  mergedFromIds    String[]        @default([])
  splitFromId      String?
  performedBy      String?
  approvedBy       String?
  approvalNotes    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  plan ProcurementPlan? @relation(fields: [planId], references: [id])

  @@map("procurement_requests")
}

model ProcurementPlan {
  id                    String     @id @default(uuid())
  planNumber            String     @unique
  fiscalYear            String
  organization          String
  responsibleDepartment String
  estimatedTotal        Decimal    @default(0) @db.Decimal(18, 2)
  approvedTotal         Decimal?   @db.Decimal(18, 2)
  status                PlanStatus @default(DRAFT)
  approvalHistory       Json       @default("[]")
  requestIds            String[]   @default([])
  generatedPackageIds   String[]   @default([])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  requests    ProcurementRequest[]
  allocations FundingAllocation[]
  proposals   PackageProposal[]

  @@map("procurement_plans")
}

model ProcurementDemand {
  id               String       @id @default(uuid())
  demandCode       String       @unique
  fiscalYear       String
  department       String
  requestIds       String[]     @default([])
  consolidatedCost Decimal      @default(0) @db.Decimal(18, 2)
  status           DemandStatus @default(OPEN)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("procurement_demands")
}

model FundingAllocation {
  id              String   @id @default(uuid())
  planId          String
  fundSourceCode  String
  allocatedAmount Decimal  @db.Decimal(18, 2)
  committedAmount Decimal  @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal  @db.Decimal(18, 2)
  budgetYear      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan ProcurementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("funding_allocations")
}

model PackageProposal {
  id                  String         @id @default(uuid())
  proposalCode        String         @unique
  planId              String
  requestIds          String[]       @default([])
  proposedPackageType String
  proposedMethod      String
  estimatedValue      Decimal        @db.Decimal(18, 2)
  fundSource          String
  justification       String?
  status              ProposalStatus @default(DRAFT)
  convertedPackageId  String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  plan ProcurementPlan @relation(fields: [planId], references: [id])

  @@map("package_proposals")
}

model AnnualProcurementPlan {
  id             String           @id @default(uuid())
  annualPlanCode String           @unique
  fiscalYear     String
  organization   String
  totalBudget    Decimal          @db.Decimal(18, 2)
  approvedBudget Decimal?         @db.Decimal(18, 2)
  planIds        String[]         @default([])
  status         AnnualPlanStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("annual_procurement_plans")
}

// ─── Phase F — Approval Module ────────────────────────────────────────────────

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  WITHDRAWN
  EXPIRED
}

enum ApprovalType {
  PLAN_APPROVAL
  PACKAGE_APPROVAL
  BIDDING_DOCUMENT_APPROVAL
  EVALUATION_RESULT_APPROVAL
  CONTRACT_APPROVAL
  PAYMENT_APPROVAL
}

enum DecisionOutcome {
  APPROVED
  REJECTED
  RETURNED
}

enum ApprovalActionEnum {
  CREATED
  SUBMITTED
  ASSIGNED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  WITHDRAWN
  COMMENTED
  ATTACHMENT_ADDED
  EXPIRED
}

enum ApprovalDocumentType {
  SUPPORTING_DOCUMENT
  LEGAL_REFERENCE
  TECHNICAL_SPEC
  COST_ESTIMATE
  AUTHORITY_CONFIRMATION
}

enum SubjectType {
  PLAN
  PACKAGE
}

model ApprovalRequest {
  id                    String         @id @default(uuid())
  requestCode           String         @unique
  approvalType          ApprovalType
  subjectId             String
  subjectType           SubjectType
  requestedBy           String
  requestedAt           DateTime       @default(now())
  department            String
  estimatedValue        BigInt
  assignedAuthorityCode String?
  assignedAuthorityName String?
  dueDate               DateTime?
  status                ApprovalStatus @default(DRAFT)
  decisionId            String?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  decision    ApprovalDecisionRecord? @relation(fields: [decisionId], references: [id])
  history     ApprovalHistoryEntry[]
  comments    ApprovalComment[]
  attachments ApprovalAttachment[]

  @@index([status])
  @@index([department])
  @@index([subjectId])
  @@index([approvalType])
  @@map("approval_requests")
}

model ApprovalDecisionRecord {
  id                String          @id @default(uuid())
  requestId         String          @unique
  outcome           DecisionOutcome
  decidedBy         String
  decidedAt         DateTime        @default(now())
  legalBasis        String
  conditions        String[]        @default([])
  revisionRequired  String[]        @default([])
  decisionReference String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  request ApprovalRequest[]

  @@index([decidedBy])
  @@map("approval_decisions")
}

model ApprovalHistoryEntry {
  id          String             @id @default(uuid())
  requestId   String
  action      ApprovalActionEnum
  performedBy String
  performedAt DateTime           @default(now())
  fromStatus  ApprovalStatus?
  toStatus    ApprovalStatus?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  request ApprovalRequest @relation(fields: [requestId], references: [id])

  @@index([requestId, performedAt])
  @@map("approval_history")
}

model ApprovalComment {
  id         String   @id @default(uuid())
  requestId  String
  content    String   @db.Text
  authorCode String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  request ApprovalRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("approval_comments")
}

model ApprovalAttachment {
  id           String               @id @default(uuid())
  requestId    String
  fileName     String
  fileType     String
  fileSize     BigInt
  uploadedBy   String
  documentType ApprovalDocumentType
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  request ApprovalRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("approval_attachments")
}

// ─── Phase G: Contract Module ─────────────────────────────────────────────────
// Status: IMPLEMENTED, PENDING PRODUCTION VERIFICATION (Phase M1) — see docs/prisma-production.md

enum ContractStatus {
  DRAFT
  SIGNED
  EFFECTIVE
  SUSPENDED
  COMPLETED
  TERMINATED
}

enum ContractType {
  LUMP_SUM
  UNIT_PRICE
  TIME_BASED
  MIXED
}

enum ContractAmendmentStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ContractMilestoneStatus {
  PENDING
  REACHED
  DELAYED
  CANCELLED
}

enum GuaranteeType {
  PERFORMANCE
  ADVANCE_PAYMENT
  WARRANTY
}

enum GuaranteeStatus {
  ACTIVE
  EXPIRED
  RETURNED
  FORFEITED
}

enum ContractActionEnum {
  CREATED
  SIGNED
  ACTIVATED
  SUSPENDED
  RESUMED
  COMPLETED
  TERMINATED
  AMENDMENT_CREATED
  AMENDMENT_APPROVED
  AMENDMENT_REJECTED
  MILESTONE_REACHED
  MILESTONE_DELAYED
  GUARANTEE_ADDED
  GUARANTEE_RETURNED
  GUARANTEE_FORFEITED
  NOTE_ADDED
  ATTACHMENT_ADDED
}

enum ContractDocumentType {
  CONTRACT_DOCUMENT
  AMENDMENT_DOCUMENT
  PERFORMANCE_SECURITY
  ADVANCE_PAYMENT_GUARANTEE
  WARRANTY_DOCUMENT
  PAYMENT_RECORD
  HANDOVER_RECORD
  INSPECTION_RECORD
  OTHER
}

model Contract {
  id                         String         @id @default(uuid())
  contractNumber             String         @unique
  contractType               ContractType
  packageId                  String
  approvalId                 String?
  workflowId                 String?
  winnerCode                 String
  winnerName                 String
  contractValue              Decimal        @db.Decimal(18, 2)
  currency                   String         @default("VND")
  signedDate                 String?
  effectiveDate              String?
  expiryDate                 String?
  performanceSecurityAmount  Decimal?       @db.Decimal(18, 2)
  performanceSecurityPercent Decimal?       @db.Decimal(5, 2)
  advancePaymentAmount       Decimal?       @db.Decimal(18, 2)
  advancePaymentPercent      Decimal?       @db.Decimal(5, 2)
  status                     ContractStatus @default(DRAFT)
  notes                      String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  amendments  ContractAmendment[]
  milestones  ContractMilestone[]
  guarantees  ContractGuarantee[]
  history     ContractHistoryEntry[]
  attachments ContractAttachment[]

  @@index([status])
  @@index([packageId])
  @@index([winnerCode])
  @@index([workflowId])
  @@index([effectiveDate])
  @@map("contracts")
}

model ContractAmendment {
  id                String                  @id @default(uuid())
  contractId        String
  amendmentNumber   Int
  amendmentCode     String                  @unique
  reason            String
  changedFields     String[]
  valueChange       Decimal?                @db.Decimal(18, 2)
  timeExtensionDays Int?
  status            ContractAmendmentStatus @default(DRAFT)
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

