  packageTypes   String[]  @default([])
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  legalBasis     Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@map("auth_approval_hierarchies")
}

model AuthPolicy {
  id          String           @id @default(uuid())
  name        String
  description String?
  resource    String
  action      String
  effect      AuthPolicyEffect
  conditions  Json
  priority    Int
  isActive    Boolean          @default(true)
  legalBasis  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([resource, action])
  @@map("auth_policies")
}

model AuthAuditEvent {
  id           String   @id @default(uuid())
  eventType    String
  userId       String
  targetUserId String?
  sessionId    String?
  resource     String?
  action       String?
  outcome      String
  reason       String?
  delegationId String?
  policyId     String?
  ipAddress    String?
  userAgent    String?
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now())
