  @@index([requestId])
  @@map("acceptance_committees")
}

model AcceptanceMember {
  id           String               @id @default(uuid())
  committeeId  String
  requestId    String
  memberCode   String
  memberName   String
  role         AcceptanceMemberRole
  organization String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  committee AcceptanceCommittee @relation(fields: [committeeId], references: [id])

  @@unique([committeeId, memberCode])
  @@index([committeeId, isActive])
  @@map("acceptance_members")
}

model AcceptanceSession {
  id            String                  @id @default(uuid())
  requestId     String
  sessionNumber Int
  sessionType   AcceptanceType
  scheduledDate String
  actualDate    String?
  location      String?
  chairmanCode  String?
  status        AcceptanceSessionStatus @default(PENDING)
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  request AcceptanceRequest @relation(fields: [requestId], references: [id])
  items   AcceptanceItem[]
  minute  AcceptanceMinute?

  @@unique([requestId, sessionNumber])
  @@index([requestId, status])
  @@map("acceptance_sessions")
}

model AcceptanceItem {
  id                 String               @id @default(uuid())
  sessionId          String
  requestId          String
  itemCode           String
  description        String
  contractedQuantity Decimal              @db.Decimal(12, 3)
  acceptedQuantity   Decimal              @db.Decimal(12, 3)
  rejectedQuantity   Decimal              @db.Decimal(12, 3)
