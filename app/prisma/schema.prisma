// ─── Phase L — Notification Module (Phase M1 production schema) ─────────────
// IMPLEMENTED, PENDING PRODUCTION VERIFICATION. Mirrors src/notification/types/
// notificationTypes.ts and auditTypes.ts — all 10 entities in NotificationRepositories.
// ScheduleTime is split into a flat, indexable `scheduledAt` column plus a `recurrence`
// Json blob (rather than one opaque Json column) so findDueSchedules() can use a real
// database index instead of scanning JSON.

enum NotifChannelType {
  EMAIL
  SMS
  PUSH
  IN_APP
  WEBHOOK
}

enum NotifPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotifDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  EXPIRED
  CANCELLED
  RETRIED
}

enum NotifMode {
  IMMEDIATE
  SCHEDULED
  DELAYED
  RECURRING
  BULK
  EVENT_DRIVEN
}

enum NotifBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Notification {
  id           String              @id @default(uuid())
  templateCode String
  subject      String
  body         String              @db.Text
  priority     NotifPriority       @default(NORMAL)
  mode         NotifMode           @default(IMMEDIATE)
  channels     NotifChannelType[]
  variables    Json                @default("{}")
  moduleType   String?
  moduleId     String?
  scheduledAt  DateTime?
  recurrence   Json?
  batchId      String?
  ruleId       String?
  status       NotifDeliveryStatus @default(QUEUED)
  createdBy    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  recipients NotificationRecipient[]
  deliveries NotificationDelivery[]

  @@index([moduleType, moduleId])
  @@index([batchId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("notification_notifications")
}

model NotificationRecipient {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  address        String
  channelType    NotifChannelType
  status         NotifDeliveryStatus @default(QUEUED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  deliveries NotificationDelivery[]

  @@index([notificationId])
  @@map("notification_recipients")
}

model NotificationChannel {
  id           String           @id @default(uuid())
  channelType  NotifChannelType
  providerType String
  isEnabled    Boolean          @default(true)
  priority     Int              @default(0)
  config       Json             @default("{}")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([channelType])
  @@map("notification_channels")
}

model NotificationTemplate {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  subjectTemplate   String
  bodyTemplate      String             @db.Text
  requiredVariables String[]           @default([])
  channels          NotifChannelType[]
  legalBasis        Json               @default("[]")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("notification_templates")
}

model NotificationDelivery {
  id                String                @id @default(uuid())
  notificationId    String
  notification      Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientId       String
  recipient         NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  channelType       NotifChannelType
  providerType      String
  status            NotifDeliveryStatus   @default(QUEUED)
  attempt           Int
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  providerMessageId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([notificationId])
  @@index([recipientId])
  @@index([status])
  @@map("notification_deliveries")
}

model NotificationBatch {
  id           String           @id @default(uuid())
  name         String
  templateCode String
  totalCount   Int
  queuedCount  Int
  sentCount    Int              @default(0)
  failedCount  Int              @default(0)
  status       NotifBatchStatus @default(PENDING)
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("notification_batches")
}

model NotificationPreference {
  id              String           @id @default(uuid())
  userId          String
  channelType     NotifChannelType
  isOptedIn       Boolean          @default(true)
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, channelType])
  @@map("notification_preferences")
}

model NotificationRule {
  id           String             @id @default(uuid())
  eventType    String
  templateCode String
  channels     NotifChannelType[]
  priority     NotifPriority      @default(NORMAL)
  isActive     Boolean            @default(true)
  conditions   Json               @default("{}")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([eventType])
  @@map("notification_rules")
}

model NotificationEvent {
  id           String    @id @default(uuid())
  eventType    String
  sourceModule String
  sourceId     String
  payload      Json      @default("{}")
  occurredAt   DateTime
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventType])
  @@index([sourceModule, sourceId])
  @@map("notification_events")
}

model NotificationAuditEvent {
  id             String   @id @default(uuid())
  eventType      String
  notificationId String?
  recipientId    String?
  deliveryId     String?
  batchId        String?
  ruleId         String?
  userId         String
  outcome        String
  reason         String?
  metadata       Json     @default("{}")
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@index([notificationId])
  @@index([userId])
  @@index([eventType])
  @@map("notification_audit_events")
}

// ─── Phase I — Payment Module (Phase M1 production schema) ──────────────────
// IMPLEMENTED, PENDING PRODUCTION VERIFICATION. Mirrors src/payment/paymentTypes.ts.
// Only the 6 entities with a repository interface in paymentRepository.ts are modeled
// (PaymentBatch/PaymentApproval/PaymentAudit/PaymentEvent have TS types but no
// repository — not persisted today, so no Prisma model, preserving existing behaviour).
// Money.amount is `bigint` per ADR-004 ("never float") — mapped to BigInt, NOT Decimal,
// to preserve arbitrary-precision integer semantics exactly (unlike the flat Decimal(18,2)
// used by the older Package/Planning/Contract modules, which predate ADR-004).

enum PaymentCurrency {
  VND
  USD
  EUR
  JPY
  AUD
}

enum PaymentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUBMITTED_TREASURY
  TREASURY_APPROVED
  TREASURY_REJECTED
  PAID
  SUSPENDED
  CANCELLED
  REJECTED
}

enum PaymentType {
  ADVANCE
  PROGRESS
  FINAL
  RETENTION_RELEASE
  WARRANTY_RELEASE
  GUARANTEE_RELEASE
}

enum TreasuryStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}

enum PaymentAction {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  TREASURY_SUBMITTED
  TREASURY_APPROVED
  TREASURY_REJECTED
  PAID
  SUSPENDED
  RESUMED
  CANCELLED
  NOTE_ADDED
  ATTACHMENT_ADDED
}

model PaymentRequest {
  id             String          @id @default(uuid())
  requestCode    String          @unique
  paymentType    PaymentType
  contractId     String
  packageId      String?
  acceptanceId   String?
  workflowId     String?
  requestedBy    String
  requestedAt    DateTime
  department     String
  amount         BigInt
  currency       PaymentCurrency @default(VND)
  legalBasis     Json            @default("[]")
  resolvedRuleId String?
  status         PaymentStatus   @default(DRAFT)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  payments     Payment[]
  installments PaymentInstallment[]
  submissions  TreasurySubmission[]
  history      PaymentHistoryEntry[]
  documents    PaymentDocument[]

  @@index([contractId])
  @@index([acceptanceId])
  @@index([status])
  @@index([department])
  @@index([paymentType])
  @@index([workflowId])
  @@map("payment_requests")
}

model Payment {
  id            String          @id @default(uuid())
  requestId     String
  request       PaymentRequest  @relation(fields: [requestId], references: [id])
  paymentNumber String          @unique
  amount        BigInt
  currency      PaymentCurrency @default(VND)
  paidAt        DateTime?
  treasuryRef   String?
  status        PaymentStatus   @default(DRAFT)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([requestId])
  @@map("payments")
}

model PaymentInstallment {
  id                String          @id @default(uuid())
  requestId         String
  request           PaymentRequest  @relation(fields: [requestId], references: [id])
  installmentCode   String          @unique
  installmentNumber Int
  amount            BigInt
  currency          PaymentCurrency @default(VND)
  dueDate           String
  paidAt            DateTime?
  status            PaymentStatus   @default(DRAFT)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([requestId])
  @@map("payment_installments")
}

model TreasurySubmission {
  id             String         @id @default(uuid())
  requestId      String
  request        PaymentRequest @relation(fields: [requestId], references: [id])
  submissionCode String         @unique
  submittedBy    String
  submittedAt    DateTime
  treasuryBranch String?
  status         TreasuryStatus @default(PENDING)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectReason   String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([requestId])
  @@map("treasury_submissions")
}

model PaymentHistoryEntry {
  id          String         @id @default(uuid())
  requestId   String
  request     PaymentRequest @relation(fields: [requestId], references: [id])
  action      PaymentAction
  performedBy String
  performedAt DateTime
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([requestId, performedAt])
  @@map("payment_history")
}

model PaymentDocument {
  id           String         @id @default(uuid())
  requestId    String
  request      PaymentRequest @relation(fields: [requestId], references: [id])
  fileName     String
  fileType     String
  fileSize     Int
  uploadedBy   String
  documentType String
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([requestId])
  @@map("payment_documents")
}

// ─── Phase X.11 — Application Runtime: Conversation Session ──────────────────
// Persists src/conversation/domain/conversationTypes.ts's AdvisoryConversationSession
// (Phase X.1, frozen shape: { id, createdAt, updatedAt, sessionState, history }) exactly as
// designed there — sessionState/history stored as JSON since they are already plain,
// self-contained value objects with no independent query need of their own fields (matching
// this module's own MemorySessionRepository, which stores the identical shape as a single
// value per key). No new domain concept invented; this is the storage of an existing one.

model ConversationSession {
  id           String   @id @default(uuid())
  sessionState Json
  history      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("conversation_sessions")
}

// ─── Phase X.13 — Conversation Persistence Recovery & Crash Resilience ────────
// Persists src/runtime/recovery/recoveryTypes.ts's RecoveryMarker exactly as designed there.
// One row per conversational-turn attempt, PENDING until the turn completes or fails -- a row
// left PENDING after a process restart is the crash-recovery signal (see recoveryTypes.ts's own
// header comment for the full rationale). Independent of ConversationSession's own status field
// by design: turn-in-flight bookkeeping and session lifecycle are different concerns.
//
// X.19 ADDITION, per X19_ARCHITECTURE_DECISION.md: `version` is the optimistic-locking token for
// resolveIfPending()'s compare-and-swap -- a monotonically-incrementing integer, not a timestamp.
// An `updatedAt`-based CAS was tried first and rejected: two near-simultaneous writes can land in
// the same millisecond, making a DateTime-based compare-and-swap silently fail to detect a real
// concurrent claim (proven by this milestone's own concurrency test before this column existed).

enum RecoveryMarkerStatus {
  PENDING
  COMPLETED
  FAILED
}

model ConversationRecoveryMarker {
  id          String               @id @default(uuid())
  sessionId   String?
  question    String
  asOfDate    String?
  status      RecoveryMarkerStatus @default(PENDING)
  startedAt   DateTime
  completedAt DateTime?
  error       String?
  version     Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([sessionId])
  @@map("conversation_recovery_markers")
}

// ─── Phase X.14 — Authentication, Authorization & Identity Infrastructure ─────
// Persists src/identity/infrastructure/sessionIdentityRepository.ts's SessionIdentityBinding
// exactly as designed there. Associates a ConversationSession (X.11, frozen, untouched) with a
// Principal by sessionId, without modifying ConversationSession's own shape -- the same parallel
// bookkeeping pattern Phase X.13's ConversationRecoveryMarker already established. No Role/
// Permission table: this milestone's roles/permissions are deterministic, built-in constants
// (src/identity/application/permissionResolver.ts), not persisted/admin-editable data.

enum PrincipalKind {
  ANONYMOUS
  USER
  SERVICE
  SYSTEM
}

model SessionIdentityBinding {
  id            String        @id @default(uuid())
  sessionId     String
  principalId   String
  principalKind PrincipalKind
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sessionId])
  @@map("session_identity_bindings")
}
