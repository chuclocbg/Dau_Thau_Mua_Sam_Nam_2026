  FINAL
  WARRANTY
}

enum AcceptanceSessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AcceptanceItemStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AcceptanceMinuteStatus {
  DRAFT
  SIGNED
  VOIDED
}

enum AcceptanceMemberRole {
  CHAIRMAN
  SECRETARY
  MEMBER
  EXPERT
}

enum AcceptanceAction {
  CREATED
  WITHDRAWN
  COMMITTEE_FORMED
  MEMBER_ADDED
  MEMBER_REMOVED
  SESSION_CREATED
  SESSION_STARTED
  SESSION_COMPLETED
  SESSION_CANCELLED
  ITEM_RECORDED
  MINUTE_CREATED
  MINUTE_SIGNED
  COMPLETED
  REJECTED
  LEGAL_BASIS_ADDED
}

enum AcceptanceDocType {
  CONTRACT_DOCUMENT
  TECHNICAL_REPORT
  TEST_RESULT
  PHOTO_EVIDENCE
  INSPECTION_CERTIFICATE
  WARRANTY_DOCUMENT
  MINUTE_ATTACHMENT
  OTHER
}

model AcceptanceRequest {
  id             String           @id @default(uuid())
  requestCode    String           @unique
  acceptanceType AcceptanceType
  contractId     String
  packageId      String?
  workflowId     String?
  requestedBy    String
  requestedAt    String
  department     String
  description    String?
  legalBasis     String[]
  status         AcceptanceStatus @default(DRAFT)
  completedAt    String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  committees  AcceptanceCommittee[]
  sessions    AcceptanceSession[]
  items       AcceptanceItem[]
  minutes     AcceptanceMinute[]
  history     AcceptanceHistoryEntry[]
  attachments AcceptanceAttachment[]

  @@index([contractId])
  @@index([status])
  @@index([workflowId])
  @@index([department])
  @@map("acceptance_requests")
}

model AcceptanceCommittee {
  id                String   @id @default(uuid())
  requestId         String   @unique
  committeeCode     String
  establishedBy     String
  establishedAt     String
  decisionReference String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request AcceptanceRequest  @relation(fields: [requestId], references: [id])
