# Required for LLM paraphrase mode (optional — app works without it in KB-only mode)
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================================================
# Docker infrastructure (docker-compose.yml) — Phase M0.
# Copy this whole file to .env, fill in real values, then: docker compose up -d
# The app (running on the host via `npm run dev`) connects to these containers
# through their published localhost ports below.
#
# IMPORTANT: this project does NOT expand ${VAR} references inside .env files
# (that needs dotenv-expand, not installed). Every value below must be a
# literal string. If you change POSTGRES_USER/PASSWORD/DB/PORT, you must also
# manually update DATABASE_URL to match — same for REDIS_PASSWORD/PORT →
# REDIS_URL, and MINIO_API_PORT → MINIO_ENDPOINT.
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=dtmsn_app
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=dtmsn
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dtmsn_app:changeme_use_a_strong_password@localhost:5432/dtmsn?schema=public

# --- pgAdmin (web UI at http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_use_a_strong_password
PGADMIN_PORT=5050

# --- Redis (cache / session store) ---
REDIS_PASSWORD=changeme_use_a_strong_password
REDIS_PORT=6379
REDIS_URL=redis://:changeme_use_a_strong_password@localhost:6379

# --- MinIO (S3-compatible object storage; console at http://localhost:9001) ---
MINIO_ROOT_USER=dtmsn_minio_admin
MINIO_ROOT_PASSWORD=changeme_use_a_strong_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_BACKUPS=backups
MINIO_ENDPOINT=http://localhost:9000
